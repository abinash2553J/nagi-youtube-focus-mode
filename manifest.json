{
  "manifest_version": 3,
  "name": "Nagi: YouTube Focus Mode",
  "version": "0.4.0",
  "description": "Calm the noise. Hides Shorts, feed and suggestions while you study.",
  "permissions": ["storage"],
  "action": { "default_title": "Toggle study mode" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["nagi.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}